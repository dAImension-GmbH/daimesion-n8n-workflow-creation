{
  "name": "n8n-workflow-creation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local workflow creation tooling for n8n.",
  "scripts": {
    "check": "node scripts/n8n.js check",
    "test:certificate": "node scripts/test-certificate-regression.js",
    "test:email-queue": "node scripts/test-email-queue.js",
    "setup:evaluations": "node scripts/setup-certificate-evaluations.js",
    "prepare:evaluations": "node scripts/prepare-certificate-evaluation-workflow.js",
    "list": "node scripts/n8n.js list",
    "validate": "node scripts/n8n.js validate workflows",
    "deploy": "node scripts/n8n.js deploy workflows",
    "update": "node scripts/n8n.js update workflows",
    "sync": "node scripts/n8n.js sync workflows",
    "pull": "node scripts/n8n.js pull workflows/exported"
  },
  "engines": {
    "node": ">=18"
  }
}
