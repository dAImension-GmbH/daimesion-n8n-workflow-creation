    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const PROCESSING = 'DAIMENSION-PROCESSING';\nconst FAILED = 'DAIMENSION-FAILED';\nconst ATTEMPT_PREFIX = 'DAIMENSION-ATTEMPT-';\nconst MAX_PARALLEL = 5;\nconst MAX_ATTEMPTS = 3;\nconst LEASE_MS = 15 * 60 * 1000;\nconst OWN_ADDRESS = 'certificates@daimension.de';\nconst DISPATCHER_LOCK_MS = 55 * 1000;\n\nconst state = $getWorkflowStaticData('global');\nconst dispatcherExecutionId = String($execution?.id ?? 'unknown');\nconst dispatcherLock = state.dispatcherLock ?? {};\nif (dispatcherLock.owner !== dispatcherExecutionId && Number(dispatcherLock.expiresAt ?? 0) > Date.now()) return [];\nstate.dispatcherLock = { owner: dispatcherExecutionId, expiresAt: Date.now() + DISPATCHER_LOCK_MS };\nstate.initialUnreadCutoff ??= new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();\nconst cutoff = Date.parse(state.initialUnreadCutoff);\nconst now = Date.now();\nconst messages = $input.all().map(item => item.json ?? {});\n\nconst categoriesOf = message => Array.isArray(message.categories) ? message.categories.map(String) : [];\nconst attemptOf = categories => {\n  const values = categories\n    .filter(category => category.startsWith(ATTEMPT_PREFIX))\n    .map(category => Number(category.slice(ATTEMPT_PREFIX.length)))\n    .filter(Number.isFinite);\n  return values.length ? Math.max(...values) : 0;\n};\nconst modifiedAt = message => Date.parse(message.lastModifiedDateTime ?? message.receivedDateTime ?? 0) || 0;\nconst senderOf = message => String(message.from?.emailAddress?.address ?? message.from?.address ?? '').trim().toLowerCase();\nconst isFreshProcessing = message => {\n  const categories = categoriesOf(message);\n  return categories.includes(PROCESSING) && now - modifiedAt(message) < LEASE_MS;\n};\n\nconst freshActive = messages.filter(isFreshProcessing).length;\nconst available = Math.max(0, MAX_PARALLEL - freshActive);\nconst output = [];\nconst candidates = [];\n\nfor (const message of messages) {\n  const categories = categoriesOf(message);\n  const attempt = attemptOf(categories);\n  const processing = categories.includes(PROCESSING);\n  const stale = processing && !isFreshProcessing(message);\n  const received = Date.parse(message.receivedDateTime ?? 0) || 0;\n  if (categories.includes(FAILED) || senderOf(message) === OWN_ADDRESS || received < cutoff) continue;\n\n  if (stale && attempt >= MAX_ATTEMPTS) {\n    output.push({ json: {\n      ...message,\n      action: 'fail',\n      attempt,\n      targetCategories: [...new Set(categories.filter(category => category !== PROCESSING).concat(FAILED))]\n    } });\n    continue;\n  }\n\n  if (!processing || stale) candidates.push({ message, categories, attempt });\n}\n\ncandidates.sort((a, b) => (Date.parse(a.message.receivedDateTime ?? 0) || 0) - (Date.parse(b.message.receivedDateTime ?? 0) || 0));\nfor (const candidate of candidates.slice(0, available)) {\n  const nextAttempt = candidate.attempt + 1;\n  const retained = candidate.categories.filter(category => category !== PROCESSING && !category.startsWith(ATTEMPT_PREFIX));\n  output.push({ json: {\n    ...candidate.message,\n    action: 'claim',\n    attempt: nextAttempt,\n    targetCategories: [...new Set(retained.concat(PROCESSING, ATTEMPT_PREFIX + nextAttempt))]\n  } });\n}\n\nreturn output;"
      },
